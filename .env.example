# ---- Supabase (optional; leave blank to run with the local file store) ----
# When NEXT_PUBLIC_SUPABASE_URL + keys are set, auth and persistence use Supabase.
# When they are blank, MarketGym runs in local mode: a single demo learner,
# data stored in ./.data/marketgym.json, no sign-up required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI (optional; leave blank for the rule-based offline coach/evaluator) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---- SoSoValue (optional; blank = clearly-labelled demo fixtures) ----
SOSOVALUE_API_KEY=
SOSOVALUE_BASE_URL=https://openapi.sosovalue.com/openapi/v1

# ---- SoDEX public market data (no key needed; read-only) ----
SODEX_MARKET_DATA_BASE_URL=https://mainnet-gw.sodex.dev/api/v1/spot
SODEX_MARKET_DATA_API_KEY=

# true = never call external APIs, always use demo fixtures (labelled as demo).
DEMO_MODE=false

# Base URL used for metadata / OG images.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local mode has no login (one shared learner). A production server refuses it
# unless you opt in explicitly, e.g. for a single-user demo deploy.
ALLOW_LOCAL_MODE=false

# ---- Production login + database (recommended for deploy) ----
# Privy login (email/Google; optional wallet, never required). App id is public.
NEXT_PUBLIC_PRIVY_APP_ID=
# Postgres connection (e.g. Supabase session pooler URL). Tables go in DB_SCHEMA, never public.
DATABASE_URL=
DB_SCHEMA=marketgym
# 32+ random characters; signs the MarketGym session cookie. `openssl rand -base64 48`
SESSION_SECRET=
